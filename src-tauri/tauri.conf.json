{
"productName": "SuperTxt",
"version": "1.0.1",
"identifier": "com.supertxt.app",
"build": {
"beforeDevCommand": "npm run dev",
"beforeBuildCommand": "npm run build",
"devUrl": "http://localhost:1421",
"frontendDist": "../dist"
},
"bundle": {
"icon": [
"icons/32x32.png",
"icons/128x128.png",
"icons/128x128@2x.png",
"icons/icon.icns",
"icons/icon.ico"
],
"targets": ["nsis"],
"windows": {
"webviewInstallMode": {
"type": "skip"
},
"nsis": {
"installerIcon": "icons/icon.ico"
}
}
},
"app": {
"withGlobalTauri": true,
"windows": [
{
"title": "SuperTxt",
"width": 1100,
"height": 750,
"minWidth": 800,
"minHeight": 600,
"center": true
}
],
"security": {
"csp": null
}
}
}